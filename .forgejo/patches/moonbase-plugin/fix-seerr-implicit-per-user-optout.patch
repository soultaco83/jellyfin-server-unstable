+using System.Text.Json;
+using Moonfin.Server.Models;
+using Moonfin.Server.Services;
+using Xunit;
+
+namespace Moonfin.Server.Tests;
+
+/// <summary>
+/// Clients used to push their own local false for the per-user Seerr switch, and that stored
+/// false then beat the admin's "enable Seerr for all users" on every later login. The cleanup
+/// has to drop a stored false, leave a deliberate true alone, and skip users who never carried
+/// the flag at all.
+/// </summary>
+public sealed class SeerrOptOutMigrationTests : IDisposable
+{
+    private readonly string _dataPath;
+    private readonly MoonfinSettingsService _service;
+
+    public SeerrOptOutMigrationTests()
+    {
+        _dataPath = Path.Combine(Path.GetTempPath(), "moonfin-seerr-tests-" + Guid.NewGuid().ToString("N"));
+        _service = new MoonfinSettingsService(new NoOpLogger<MoonfinSettingsService>(), _dataPath);
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_dataPath))
+        {
+            Directory.Delete(_dataPath, recursive: true);
+        }
+    }
+
+    private Guid SeedUser(bool? seerrEnabled)
+    {
+        var userId = Guid.NewGuid();
+        var json = JsonSerializer.Serialize(
+            new MoonfinUserSettings
+            {
+                SchemaVersion = 2,
+                SyncEnabled = true,
+                Global = new MoonfinSettingsProfile
+                {
+                    SeerrEnabled = seerrEnabled,
+                    CinemaModeEnabled = true,
+                },
+                LastUpdated = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
+                LastUpdatedBy = "test-seed",
+            },
+            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
+
+        Directory.CreateDirectory(_dataPath);
+        File.WriteAllText(Path.Combine(_dataPath, userId + ".json"), json);
+        return userId;
+    }
+
+    private MoonfinUserSettings Read(Guid userId)
+    {
+        var json = File.ReadAllText(Path.Combine(_dataPath, userId + ".json"));
+        return JsonSerializer.Deserialize<MoonfinUserSettings>(
+            json,
+            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })!;
+    }
+
+    [Fact]
+    public async Task ClearingStaleOptOutsDropsTheStoredFalseAndKeepsTheRest()
+    {
+        var optedOut = SeedUser(seerrEnabled: false);
+        var optedIn = SeedUser(seerrEnabled: true);
+        var neverSet = SeedUser(seerrEnabled: null);
+
+        var cleared = await _service.ClearStaleSeerrOptOutsAsync();
+
+        Assert.Equal(1, cleared);
+
+        // The stored false is what made the admin setting lose, so it has to become unset
+        // rather than true: unset is what lets the server default apply again.
+        Assert.Null(Read(optedOut).Global!.SeerrEnabled);
+
+        // A user who asked for Seerr keeps it, and one who never touched the switch is left
+        // as they were.
+        Assert.Equal(true, Read(optedIn).Global!.SeerrEnabled);
+        Assert.Null(Read(neverSet).Global!.SeerrEnabled);
+
+        // A second pass finds nothing left to do, which is what lets a later opt-out stand.
+        Assert.Equal(0, await _service.ClearStaleSeerrOptOutsAsync());
+    }
+}
