+    /// <summary>
+    /// Undoes the per-user opt-out that older clients pushed on the user's behalf.
+    /// A client that had never been asked echoed its own false default into the profile,
+    /// and that stored false outranked the admin's Seerr switch on every later login, so
+    /// each user had to enable Seerr by hand. Clearing it once restores the default.
+    /// Guarded by a config version, so a user who turns Seerr off afterwards stays off.
+    /// </summary>
+    private async Task ClearStaleSeerrOptOutsAsync()
+    {
+        try
+        {
+            var plugin = MoonfinPlugin.Instance;
+            var config = plugin?.Configuration;
+            if (config == null || !config.SeerrEnabled)
+            {
+                return;
+            }
+
+            if (config.SeerrOptOutResetVersion >= 1)
+            {
+                return;
+            }
+
+            var cleared = await _settings.ClearStaleSeerrOptOutsAsync();
+
+            config.SeerrOptOutResetVersion = 1;
+            plugin?.SaveConfiguration();
+
+            if (cleared > 0)
+            {
+                _logger.LogInformation(
+                    "Cleared a stale Seerr opt-out for {Count} user(s) so the admin Seerr setting applies again.",
+                    cleared);
+            }
+        }
+        catch (Exception ex)
+        {
+            // Never fatal: the next start retries because the version is still unset.
+            _logger.LogDebug(ex, "Clearing stale Seerr opt-outs failed (non-fatal)");
+        }
+    }
