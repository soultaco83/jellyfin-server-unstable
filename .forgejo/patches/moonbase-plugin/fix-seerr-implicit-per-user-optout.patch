+    /// <summary>
+    /// Clears the per-user Seerr opt-out that clients wrote without the user asking for it.
+    /// The client shipped a local default of false and echoed it into the profile on every
+    /// push, which then beat the admin's "enable Seerr for all users" on every later login
+    /// and left each affected user to switch Seerr on by hand. Dropping the value puts the
+    /// flag back to unset, which is what makes the server default apply again.
+    /// </summary>
+    /// <returns>The number of users whose stale value was cleared.</returns>
+    public async Task<int> ClearStaleSeerrOptOutsAsync()
+    {
+        if (!Directory.Exists(_dataPath))
+        {
+            return 0;
+        }
+
+        var cleared = 0;
+
+        await _lock.WaitAsync();
+        try
+        {
+            foreach (var file in Directory.EnumerateFiles(_dataPath, "*.json"))
+            {
+                var fileName = Path.GetFileNameWithoutExtension(file);
+                if (!Guid.TryParse(fileName, out _))
+                {
+                    continue;
+                }
+
+                var settings = ReadSettingsWithRecovery(file);
+                if (settings == null)
+                {
+                    continue;
+                }
+
+                if (settings.NeedsMigration)
+                {
+                    settings = MigrateV1ToV2(settings);
+                }
+
+                var changed = false;
+
+                if (settings.Global?.SeerrEnabled == false)
+                {
+                    settings.Global.SeerrEnabled = null;
+                    changed = true;
+                }
+
+                // v1 carried the flag at the root, and the read path still falls back to it.
+                if (settings.SeerrEnabled == false)
+                {
+                    settings.SeerrEnabled = null;
+                    changed = true;
+                }
+
+                if (!changed)
+                {
+                    continue;
+                }
+
+                AtomicFile.WriteAllText(file, JsonSerializer.Serialize(settings, _jsonOptions));
+                cleared++;
+            }
+        }
+        finally
+        {
+            _lock.Release();
+        }
+
+        return cleared;
+    }
