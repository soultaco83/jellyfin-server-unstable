{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git apply --check*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "ls*": "allow",
      "wc *": "allow"
    }
  }
}
